# Copy to `.env` for `pnpm dev` (gitignored). Loaded only off a host (no
# K_SERVICE, no RAILWAY_SERVICE_NAME), so a deployment never reads a .env file.
#
# Every variable here is optional for the server to BOOT. Missing LINE values
# are a state, not a crash: /webhook answers 503 line_not_configured, and
# /api/liff/* answers 503 liff_not_configured.

# ── LINE Messaging API channel (the OA) ──────────────────────────────────────
# Developers Console → the OA's Messaging API channel. Check the channel's
# title in the console before you paste: staging and prod must never cross.
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# Which channel the token above belongs to: staging | prod. Scripts that use
# the token (pnpm line:whoami) refuse to run without it.
LINE_CHANNEL_TARGET=staging

# ── LINE Login channel (holds the LIFF app) ──────────────────────────────────
# The LIFF id, e.g. 2001234567-AbCdEfGh. Not a secret: it is in every LIFF URL.
LIFF_ID=
# The LINE Login channel id the LIFF ID tokens are issued for (the numeric
# part before the dash). LIFF_CHANNEL_IDS takes a comma list instead.
LIFF_CHANNEL_ID=
# LIFF_CHANNEL_IDS=

# ── server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── local dev only: skip LINE login ──────────────────────────────────────────
# With both set, `Authorization: Bearer dev-liff` is accepted as this user.
# The server refuses to boot on Cloud Run or Railway if either is present.
# Pair with VITE_DEV_LIFF_TOKEN=dev-liff in liff-app/.env.local.
# ALLOW_DEV_LIFF_AUTH=true
# LIFF_DEV_USER_ID=Udev0000000000000000000000000000

# ── database (the one น้องน้ำ uses) ─────────────────────────────────────────
# Service role, server side only. For now the staging deployment uses PROD
# (gydtpgeequcfbrvgubso) and writes only to farms this OA created. Unset =
# every farm route answers 503 db_not_configured.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── measuring (line-bot's sizing service, cloud-services/shrimp-sizing) ──────
# Unset = measuring answers 503 measure_not_configured (the quota is refunded).
SIZING_SERVICE_URL=
SIZING_SERVICE_SECRET=
# Measures per farm per day. A farm that scans every pond daily needs at least
# its pond count.
SCAN_DAILY_LIMIT=20

# ── รหัสเข้าร่วม (src/domain/gate.ts) ──────────────────────────────────────
# The code a new owner types before making a farm, like น้องน้ำ's beta gate.
# Unset = open: any non-empty code passes. Case, spaces and dashes are ignored.
# Someone an owner invited types the invite code instead and never needs this.
BETA_ACCESS_CODE=
