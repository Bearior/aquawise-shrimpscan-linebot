# Copy to .env.local for `pnpm dev` against a local server (pnpm dev in the repo root).
# Dev-only token for the server's gated dev bypass (needs ALLOW_DEV_LIFF_AUTH=true
# and LIFF_DEV_USER_ID on the server). Never set in a build: import.meta.env.DEV
# is false there, so the bypass is compiled out.
VITE_DEV_LIFF_TOKEN=dev-liff
# Optional: skip /api/liff-config for the LIFF id while developing.
# VITE_LIFF_ID=
