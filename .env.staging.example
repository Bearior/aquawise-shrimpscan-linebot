# =====================================================================
# Shrimp Scan LINE bot, STAGING channel values (.env.staging)
# =====================================================================
# Copy to `.env.staging` (gitignored) and fill in REAL staging values.
# Use it for anything run against the STAGING OA from this PC, e.g.
#   node --env-file=.env.staging --import tsx scripts/line-whoami.ts
#
# Why a separate file: line-bot once ran its staging database with the PROD
# LINE token (2026-05-31). The token alone does not say which channel it is
# for, so this file says it out loud, and scripts refuse to run without it.
# =====================================================================

# REQUIRED: the channel this file targets.
LINE_CHANNEL_TARGET=staging

# From: LINE Developers Console → "<APP_NAME> staging" → Messaging API tab.
# MUST be the STAGING channel, NOT prod. Check the console title before
# pasting a token.
LINE_CHANNEL_SECRET=your_STAGING_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_STAGING_channel_access_token_here

# The STAGING LIFF app, on the "<APP_NAME> LIFF staging" Login channel.
LIFF_ID=your_STAGING_liff_id_here
LIFF_CHANNEL_ID=your_STAGING_login_channel_id_here
